# Never commit a real .env file or API key.
PORT=3001
NODE_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Comma-separated exact origins allowed to call this API.
# Example: http://localhost:5500,https://www.terceirizadp.com.br
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://www.terceirizadp.com.br,https://terceirizadp.com.br